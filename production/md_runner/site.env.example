# Site configuration sourced by task.sh. Copy to site.env next to the campaign files and edit.
# All paths are site-specific; none is needed to rebuild the tables or figures of this repository.
SITE_BASE=/path/to/shared/workdir          # holds runtime/: container image and package tarballs
SITE_BIND=/path/to/shared                  # file system bound into the container
SINGULARITY_BIN=/path/to/singularity/bin
SQUASHFUSE_HOME=/path/to/squashfuse        # unprivileged SIF mounts
MODEL_PATH=/path/to/mace_mp0_small.model   # sha256 2ddb079cee0e131eaaf6912ba581b394551ead283e95c99cfe78c605d10b5736
